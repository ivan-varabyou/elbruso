{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@elbruso/shared": ["./src/index.ts"],
      "@elbruso/shared/*": ["./src/*"],
      "@elbruso/api": ["./src/api/index.ts"],
      "@elbruso/api/*": ["./src/api/*"],
      "@elbruso/hooks": ["./src/api/hooks/index.ts"],
      "@elbruso/hooks/*": ["./src/api/hooks/*"],
      "@elbruso/stores": ["./src/stores/index.ts"],
      "@elbruso/stores/*": ["./src/stores/*"],
      "@elbruso/types": ["./src/types/index.ts"],
      "@elbruso/types/*": ["./src/types/*"],
      "@elbruso/lib": ["./src/lib/index.ts"],
      "@elbruso/lib/*": ["./src/lib/*"],
      "@elbruso/modules/*": ["./src/modules/*"],
      "@elbruso/ui/primitives": ["./src/ui/primitives/index.ts"],
      "@elbruso/ui/primitives/*": ["./src/ui/primitives/*"],
      "@elbruso/ui/layout": ["./src/ui/layout/index.ts"],
      "@elbruso/ui/layout/*": ["./src/ui/layout/*"],
      "@elbruso/ui/*": ["./src/ui/*"],
      "@elbruso/ui": ["./src/ui/index.ts"],
      "@elbruso/app/*": ["./src/app/*"],
      "@elbruso/app/providers": ["./src/app/providers/index.ts"],
      "@elbruso/debug": ["../debug/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
