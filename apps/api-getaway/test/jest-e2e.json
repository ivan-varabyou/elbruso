{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": "tsconfig.json", "isolatedModules": true }
    ]
  },
  "moduleNameMapper": {
    "^@apigateway/(.*)$": "<rootDir>/src/$1",
    "^@database$": "<rootDir>/../../packages/database/src/index",
    "^@database/(.*)$": "<rootDir>/../../packages/database/src/$1",
    "^@backend$": "<rootDir>/../../packages/backend/src/index",
    "^@backend/(.*)$": "<rootDir>/../../packages/backend/src/$1",
    "^@shared/(.*)$": "<rootDir>/../../packages/shared/src/$1",
    "^@frontend/(.*)$": "<rootDir>/../../packages/frontend/src/$1"
  }
}
