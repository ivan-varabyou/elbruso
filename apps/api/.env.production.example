# ==============================================
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env.production and fill in values
# ==============================================

# ---------- DATABASE ----------
# Development: postgresql://elbruso:elbruso@localhost:7900/elbruso
# Production:  postgresql://user:password@hostname:5432/elbruso?sslmode=require
DATABASE_URL=postgresql://elbruso:elbruso@localhost:7900/elbruso

# ---------- JWT & SECURITY ----------
# Generate with: ./scripts/generate-secrets.sh jwt
JWT_SECRET=                    # 64-char hex secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Generate with: ./scripts/generate-secrets.sh admin
ADMIN_JWT_SECRET=              # 64-char hex secret
ADMIN_JWT_EXPIRES_IN=1h
ADMIN_REFRESH_SECRET=          # 64-char hex secret
ADMIN_REFRESH_EXPIRES_IN=7d

# ---------- SERVER ----------
NODE_ENV=production
PORT=7100
WS_PORT=7000
CORS_ORIGINS=https://app.elbruso.com

# ---------- REDIS (cache) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- MESSAGING ----------
MESSAGING_ENABLED=true
MESSAGING_TYPE=rabbitmq
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60

# ---------- MONITORING ----------
SENTRY_DSN=
