{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "globalSetup": "<rootDir>/apps/api/test/global-setup.js",
  "setupFiles": ["<rootDir>/apps/api/test/setup-env.js"],
  "moduleDirectories": ["node_modules", "<rootDir>/apps/api/src", "<rootDir>/packages/database/src", "<rootDir>/packages/types/src"]
}
