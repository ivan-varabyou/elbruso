{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "qwen-code": {}
  },
  "skills": {
    "paths": [".agent/skills"]
  },
  "mcp": {
    "heroui": {
      "type": "local",
      "command": ["npx", "-y", "@heroui/react-mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["python3", "/home/ivan/git/elbruso/packages/context/mcp-server/server.py"],
      "environment": {
        "PROJECT_NAME": "elbruso",
        "QDRANT_URL": "http://localhost:7999"
      },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/ivan/git/elbruso"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "environment": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "enabled": false
    }
  }
}
