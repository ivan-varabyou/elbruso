# Database Configuration
DB_HOST=localhost
DB_PORT=7900  # PostgreSQL (79xx - databases)
DB_NAME=elbruso
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=7800  # Redis (78xx - cache/utilities)

# API Configuration
PORT=7100  # Main API (71xx - backend microservices)
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:7200,http://localhost:7201

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
