{
  "name": "elbruso",
  "private": true,
  "description": "BI System with dynamic tables and reports",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && pnpm -r exec rm -rf dist .turbo .next && find . -type f \\( -name \"*.js\" -o -name \"*.js.map\" -o -name \"*.d.ts\" \\) -path \"*/src/*\" -not -path \"*/node_modules/*\" -delete",
    "dev": "./scripts/dev-setup.sh",
    "dev:only": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate:api": "swagger-typescript-api generate -p ./swagger.json -o ./packages/frontend/src/api --react-hooks --axios --modular --exportSchemas",
    "generate:api:watch": "swagger-typescript-api generate -p ./swagger.json -o ./packages/frontend/src/api --react-hooks --axios --modular --exportSchemas --watch"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/lodash-es": "^4.17.12",
    "ai-factory": "^1.4.0",
    "babel-loader": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "openapi-typegen": "^2.0.1",
    "prettier": "^3.8.0",
    "swagger-typescript-api": "^13.2.16",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.54.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@heroui/react": "^2.8.8",
    "@heroui/theme": "^2.4.26",
    "@tanstack/react-query": "^5.90.20",
    "@types/d3-sankey": "^0.12.5",
    "@types/nodemailer": "^7.0.5",
    "ag-grid-community": "^35.0.1",
    "ag-grid-react": "^35.0.1",
    "bcrypt": "^6.0.0",
    "d3-sankey": "^0.12.3",
    "date-fns": "^4.1.0",
    "hyperformula": "^3.1.1",
    "lodash-es": "^4.17.23",
    "nodemailer": "^7.0.12",
    "zustand": "^5.0.10"
  }
}
